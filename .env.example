# ---- Gemini (servidor) ----
GEMINI_API_KEY=tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash

# ---- Firebase (cliente): Configuración del proyecto > Tus apps > App web ----
# Estos valores son públicos por diseño (no son secretos).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (SERVIDOR, SECRETO): Cuentas de servicio > Generar nueva clave privada ----
FIREBASE_PROJECT_ID=tu-proyecto
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com
# Pega la clave entre comillas, con los saltos de línea como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Precio ----
# Tipo de cambio referencial CLP por 1 USD (para mostrar la equivalencia en dólares)
NEXT_PUBLIC_CLP_USD_RATE=950
